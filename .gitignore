# Repository di isotype.org: il CMS (WS) e i progetti che ci vivono dentro —
# Meetoo su tutti. La radice del repository è la radice del sito.

.DS_Store
.claude/

# ---------------------------------------------------------------------------
# SEGRETI — per primi, perché contano più di tutto il resto.
# Una chiave finita in un repository pubblico va considerata compromessa e
# rigenerata: toglierla con un commit non basta, resta nella storia.
# ---------------------------------------------------------------------------
ws-custom/ws-config.php
ws-custom/client_secret_*.json
ws-admin/places/config.php
# Dati personali (nome, email): mai versionati, mai pubblicati.
ws-admin/_private/

# ---------------------------------------------------------------------------
# CONTENUTI — dati reali, spesso personali, e 1,5 GB di media.
# Sono gestiti a parte e sincronizzati col server; il repository tiene il CODICE
# che li manipola, non i dati. Per questo restano fuori tutti, meetoo compreso.
# ---------------------------------------------------------------------------
ws-custom/contents/

# Sotto `ws-custom/` questa è l'UNICA cartella fuori. `languages/`, `plugins/` e
# `themes/` sono codice del sito e stanno nel repository: il plugin di accesso è
# scritto qui, e tenerlo fuori voleva dire che una correzione al tema viaggiava e
# quella al plugin no. Se un giorno compare una cartella nuova sotto ws-custom/,
# la regola non la copre: va deciso caso per caso, non per abitudine.

# ---------------------------------------------------------------------------
# Generato, scaricato o pesante: si ricostruisce, non si versiona.
# ---------------------------------------------------------------------------
# Plugin DI TERZE PARTI. I nostri (google-login, google-recaptcha, slider, amp)
# stanno nel repository: sono codice del sito. Questi no — si riscaricano dalla
# loro origine, e due di loro non si potrebbero versionare comunque perché hanno
# un `.git` proprio: git li registrerebbe come riferimenti che un clone non sa
# risolvere.
# (Il `#` fa commento solo a inizio riga: in coda a un percorso finirebbe dentro
# il pattern, e la regola non varrebbe niente.)
# github.com/thoughtbot/bourbon
ws-custom/plugins/bourbon/
# github.com/absalomedia/sassphp
ws-custom/plugins/sassphp/
# 60 MB in 10.116 file — github.com/googleapis/google-api-php-client
ws-custom/plugins/google-api-php-client/
ws-custom/plugins/google-api-services-mybusiness/

**/node_modules/
ws-admin/json-xml/uploads/
*.tgz

# Cartella di lavoro rimasta dal trasloco di Meetoo verso la radice.
sinapsi/

# Copia scaricata dal server, per confronto: non è codice del progetto, è una
# fotografia. Si rifà quando serve, non si versiona.
archive/themes/
