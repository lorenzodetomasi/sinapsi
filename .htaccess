# The tools of the author's computer are never served, even when a hand upload
# carries them here: deploy/ holds the FTP passwords of both servers.
<IfModule mod_alias.c>
RedirectMatch 404 ^/(deploy|archive|\.claude|ws-admin/edit-src)(/|$)
</IfModule>

# meetoo.it answers on https only. TopHost's own rule for a site with its own
# .htaccess: behind its proxy, X-Forwarded-Proto says what the visitor used.
# Only for meetoo.it: isotype.org is left as it is.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^www\.meetoo\.it$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

Redirect 301 /facebook-review https://www.facebook.com/pg/isotypeorg/reviews/
Redirect 301 /google-review https://www.google.it/search?q=ISOTYPE.ORG%2C%20via%20Angelo%20Bertolotto%2019%2C%20scala%20A%20interno%209%2C%2000122%20Lido%20di%20Ostia%2C%20Roma%20RM&ludocid=9748451456443728681&ved=1i%3A2%2Ct%3A10503%2Ce%3A1%2Cp%3AyAe0WM2sKIP5dM_ZmdAD%3A13&ei=yAe0WM2sKIP5dM_ZmdAD%3A24&hl=it-IT#fpstate=lie&lrd=0x1325efd79e9b0157:0x874974f33b77c329,3,5
