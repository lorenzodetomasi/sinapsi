# Copia questo file in `.env.local` e inserisci la tua chiave.
# .env.local è gitignored: la chiave non finirà nel repo.
# Chiave Google Maps JavaScript API con Places API abilitato,
# ristretta per referrer (http://localhost:5173 in sviluppo).
VITE_GOOGLE_MAPS_API_KEY=

# URL del backend PHP (convertitore/validatore/upload) in PRODUZIONE.
# In sviluppo lascialo vuoto (si usa il proxy /api verso :8080).
#
# CONSIGLIATO: NON impostarlo qui/in .env.local (varrebbe anche per `npm run dev`).
# Mettilo in `.env.production` (anch'esso gitignored, applicato solo da
# `vite build`), così lo sviluppo continua a usare il proxy /api e solo la build
# di produzione punta al server reale. Esempio del valore usato su isotype.org:
#   VITE_API_BASE=https://www.isotype.org/sinapsi/ws-admin/json-xml/index.php
VITE_API_BASE=
